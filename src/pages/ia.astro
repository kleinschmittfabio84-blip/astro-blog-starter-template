---
// Standalone full-screen AI assistant — no sidebar layout
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FabioAI – Assistente de Voz e Visão</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --blue: #2563eb;
        --blue-light: #3b82f6;
        --green: #10b981;
        --amber: #f59e0b;
        --red: #ef4444;
      }

      html, body {
        width: 100%; height: 100%;
        overflow: hidden;
        background: #000;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #fff;
        user-select: none;
      }

      /* ── Camera background ─────────────────── */
      #cam-bg {
        position: fixed; inset: 0;
        width: 100%; height: 100%;
        object-fit: cover;
        transform: scaleX(-1);
        filter: brightness(0.28);
        z-index: 1;
        display: none;
      }

      .no-cam-bg {
        position: fixed; inset: 0;
        background: radial-gradient(ellipse at 30% 40%, #1e1b4b 0%, #0f172a 50%, #0c1220 100%);
        z-index: 1;
      }

      .grain-overlay {
        position: fixed; inset: 0; z-index: 2;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
        pointer-events: none;
      }

      /* ── Camera PiP ────────────────────────── */
      #cam-pip {
        position: fixed; bottom: 140px; right: 20px;
        width: 150px; height: 110px;
        border-radius: 14px; overflow: hidden;
        border: 1.5px solid rgba(255,255,255,0.18);
        box-shadow: 0 8px 32px rgba(0,0,0,0.6);
        z-index: 20; display: none;
        backdrop-filter: blur(4px);
      }

      #cam-pip video {
        width: 100%; height: 100%;
        object-fit: cover;
        transform: scaleX(-1);
      }

      .pip-label {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.7));
        font-size: 0.6rem; text-align: center;
        padding: 4px; color: rgba(255,255,255,0.6);
      }

      /* ── Main UI shell ─────────────────────── */
      .ui {
        position: fixed; inset: 0; z-index: 10;
        display: flex; flex-direction: column;
        padding: 1.25rem 1.5rem;
      }

      /* ── Top bar ───────────────────────────── */
      .top-bar {
        display: flex; align-items: center; justify-content: space-between;
        flex-shrink: 0;
      }

      .back-btn {
        display: flex; align-items: center; gap: 0.4rem;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 999px;
        padding: 0.4rem 0.9rem;
        color: rgba(255,255,255,0.7);
        font-size: 0.8rem; font-weight: 500;
        text-decoration: none; cursor: pointer;
        transition: all 0.2s;
      }
      .back-btn:hover { color: #fff; background: rgba(255,255,255,0.14); }

      .logo-pill {
        display: flex; align-items: center; gap: 0.6rem;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 999px;
        padding: 0.4rem 1rem;
      }

      .logo-pill .dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 0 3px rgba(16,185,129,0.25);
        animation: blink 2s ease-in-out infinite;
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }

      .logo-pill .name { font-size: 0.9rem; font-weight: 700; letter-spacing: -0.01em; }
      .logo-pill .version { font-size: 0.65rem; color: rgba(255,255,255,0.45); }

      .top-actions { display: flex; gap: 0.5rem; }

      .top-btn {
        width: 38px; height: 38px; border-radius: 50%;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.75);
        font-size: 0.95rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.2s;
      }
      .top-btn:hover { background: rgba(255,255,255,0.16); color: #fff; }
      .top-btn.cam-off { background: rgba(239,68,68,0.25); border-color: rgba(239,68,68,0.4); color: var(--red); }

      /* ── Center ────────────────────────────── */
      .center {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 2rem; overflow: hidden;
      }

      /* ── AI Orb ────────────────────────────── */
      .orb-wrap {
        display: flex; flex-direction: column; align-items: center; gap: 1rem;
        position: relative;
      }

      .orb {
        width: 130px; height: 130px; position: relative;
        cursor: default;
      }

      .orb-r2 {
        position: absolute; inset: -22px; border-radius: 50%;
        border: 1px solid rgba(59,130,246,0.12);
        animation: ring 4s ease-in-out infinite 0.8s;
      }
      .orb-r1 {
        position: absolute; inset: -11px; border-radius: 50%;
        border: 1.5px solid rgba(59,130,246,0.22);
        animation: ring 4s ease-in-out infinite;
      }
      @keyframes ring {
        0%, 100% { transform: scale(1); opacity: 0.6; }
        50% { transform: scale(1.06); opacity: 1; }
      }

      .orb-core {
        width: 100%; height: 100%; border-radius: 50%;
        background: radial-gradient(circle at 38% 32%, #93c5fd, #2563eb 45%, #0c1220);
        box-shadow:
          0 0 40px rgba(37,99,235,0.55),
          0 0 80px rgba(37,99,235,0.22),
          inset 0 0 24px rgba(147,197,253,0.12);
        animation: orb-idle 3.5s ease-in-out infinite;
        transition: background 0.6s, box-shadow 0.4s;
      }

      @keyframes orb-idle {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.04); }
      }

      /* State variations */
      .orb.listening .orb-core {
        background: radial-gradient(circle at 38% 32%, #6ee7b7, #10b981 45%, #052e16);
        box-shadow: 0 0 50px rgba(16,185,129,0.65), 0 0 100px rgba(16,185,129,0.25);
        animation: orb-listen 0.55s ease-in-out infinite alternate;
      }
      @keyframes orb-listen {
        from { transform: scale(0.96); }
        to { transform: scale(1.06); }
      }

      .orb.thinking .orb-core {
        animation: orb-think 1.2s ease-in-out infinite;
      }
      @keyframes orb-think {
        0% { transform: scale(1) rotate(0deg); filter: hue-rotate(0deg); }
        50% { transform: scale(1.03) rotate(8deg); filter: hue-rotate(30deg); }
        100% { transform: scale(1) rotate(0deg); filter: hue-rotate(0deg); }
      }

      .orb.speaking .orb-core {
        background: radial-gradient(circle at 38% 32%, #fde68a, #f59e0b 45%, #451a03);
        box-shadow: 0 0 50px rgba(245,158,11,0.65), 0 0 100px rgba(245,158,11,0.25);
        animation: orb-speak 0.35s ease-in-out infinite alternate;
      }
      @keyframes orb-speak {
        from { transform: scale(1); }
        to { transform: scale(1.09); }
      }

      .orb-status {
        font-size: 0.82rem; font-weight: 500;
        color: rgba(255,255,255,0.6);
        min-height: 1.2em; text-align: center;
        letter-spacing: 0.01em;
      }

      /* ── Messages ──────────────────────────── */
      .msgs {
        width: 100%; max-width: 560px;
        display: flex; flex-direction: column; gap: 0.6rem;
        max-height: 32vh; overflow-y: auto;
        scrollbar-width: none; padding: 0 0.25rem;
      }
      .msgs::-webkit-scrollbar { display: none; }

      .msg {
        display: flex; gap: 0.6rem;
        animation: msg-in 0.28s ease-out;
      }
      @keyframes msg-in {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .msg.user { flex-direction: row-reverse; }

      .msg-av {
        width: 28px; height: 28px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; flex-shrink: 0; margin-top: 2px;
      }
      .msg.ai .msg-av {
        background: rgba(37,99,235,0.3);
        border: 1px solid rgba(59,130,246,0.35);
      }
      .msg.user .msg-av {
        background: rgba(16,185,129,0.25);
        border: 1px solid rgba(16,185,129,0.3);
      }

      .msg-bub {
        padding: 0.55rem 0.9rem;
        font-size: 0.875rem; line-height: 1.55; max-width: 82%;
        backdrop-filter: blur(12px);
      }
      .msg.ai .msg-bub {
        background: rgba(37,99,235,0.22);
        border: 1px solid rgba(59,130,246,0.22);
        border-radius: 1rem 1rem 1rem 0.2rem;
      }
      .msg.user .msg-bub {
        background: rgba(16,185,129,0.18);
        border: 1px solid rgba(16,185,129,0.18);
        border-radius: 1rem 1rem 0.2rem 1rem;
      }

      /* ── Bottom bar ────────────────────────── */
      .bottom {
        display: flex; flex-direction: column; align-items: center;
        gap: 0.85rem; flex-shrink: 0;
      }

      /* Transcript pill */
      .transcript-pill {
        background: rgba(0,0,0,0.35);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 999px;
        padding: 0.4rem 1.1rem;
        font-size: 0.8rem; color: rgba(255,255,255,0.7);
        min-width: 200px; max-width: 420px; text-align: center;
        min-height: 32px; display: flex; align-items: center; justify-content: center;
        transition: all 0.2s;
      }
      .transcript-pill.active {
        border-color: rgba(16,185,129,0.4);
        color: #6ee7b7;
      }

      /* Mic button */
      .mic-row {
        display: flex; align-items: center; gap: 1.25rem;
      }

      .mic-btn {
        width: 68px; height: 68px; border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        border: none; color: #fff;
        font-size: 1.5rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 24px rgba(37,99,235,0.5);
        transition: all 0.2s; position: relative;
      }
      .mic-btn:hover { transform: scale(1.06); box-shadow: 0 6px 32px rgba(37,99,235,0.7); }

      .mic-btn.recording {
        background: linear-gradient(135deg, var(--red), #dc2626);
        box-shadow: 0 4px 24px rgba(239,68,68,0.55);
        animation: mic-rec 1s ease-in-out infinite;
      }
      @keyframes mic-rec {
        0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.45); }
        50% { box-shadow: 0 0 0 18px rgba(239,68,68,0); }
      }

      .side-btn {
        width: 44px; height: 44px; border-radius: 50%;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.7);
        font-size: 1rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.2s;
      }
      .side-btn:hover { background: rgba(255,255,255,0.16); color: #fff; }

      .mic-hint {
        font-size: 0.7rem; color: rgba(255,255,255,0.35);
        text-align: center; letter-spacing: 0.02em;
      }

      /* Text input */
      .text-row {
        display: flex; gap: 0.5rem;
        width: 100%; max-width: 460px;
      }

      .txt-inp {
        flex: 1;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        color: #fff; font-size: 0.875rem;
        outline: none; transition: border-color 0.2s;
      }
      .txt-inp::placeholder { color: rgba(255,255,255,0.32); }
      .txt-inp:focus { border-color: rgba(59,130,246,0.5); }

      .send-btn {
        width: 38px; height: 38px; border-radius: 50%;
        background: rgba(37,99,235,0.45);
        border: 1px solid rgba(59,130,246,0.35);
        color: #fff; font-size: 0.9rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.2s; flex-shrink: 0;
      }
      .send-btn:hover { background: rgba(37,99,235,0.7); }

      /* ── Toast ─────────────────────────────── */
      #toast {
        position: fixed; top: 72px; left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.12);
        color: #fff; padding: 0.5rem 1.1rem;
        border-radius: 999px; font-size: 0.8rem;
        z-index: 100; display: none;
        animation: toast-in 0.25s ease-out;
        max-width: 80vw; text-align: center;
      }
      @keyframes toast-in {
        from { opacity: 0; transform: translateX(-50%) translateY(-6px); }
        to { opacity: 1; transform: translateX(-50%) translateY(0); }
      }

      /* ── Setup banner ──────────────────────── */
      #setup-banner {
        position: fixed; top: 72px; left: 50%;
        transform: translateX(-50%);
        background: rgba(245,158,11,0.15);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(245,158,11,0.35);
        border-radius: 12px;
        padding: 0.75rem 1.25rem;
        z-index: 50; display: none;
        max-width: 480px; width: 90%;
        text-align: center;
      }
      #setup-banner .title { font-size: 0.85rem; font-weight: 600; color: #fde68a; margin-bottom: 0.3rem; }
      #setup-banner .desc { font-size: 0.75rem; color: rgba(255,255,255,0.6); line-height: 1.5; }
      #setup-banner code {
        background: rgba(0,0,0,0.3); border-radius: 4px;
        padding: 1px 5px; font-size: 0.7rem; color: #93c5fd;
      }

      /* ── Capture indicator ─────────────────── */
      #capture-indicator {
        position: fixed; top: 72px; right: 24px;
        background: rgba(16,185,129,0.2);
        border: 1px solid rgba(16,185,129,0.4);
        border-radius: 8px; padding: 0.4rem 0.75rem;
        font-size: 0.75rem; color: #6ee7b7;
        z-index: 50; display: none;
      }

      @media (max-width: 480px) {
        .orb { width: 100px; height: 100px; }
        .msgs { max-height: 28vh; }
        .text-row { max-width: 340px; }
      }
    </style>
  </head>
  <body>
    <!-- Backgrounds -->
    <div class="no-cam-bg" id="no-cam-bg"></div>
    <div class="grain-overlay"></div>
    <video id="cam-bg" autoplay muted playsinline></video>

    <!-- Camera PiP -->
    <div id="cam-pip">
      <video id="cam-pip-vid" autoplay muted playsinline></video>
      <div class="pip-label">Você</div>
    </div>

    <!-- Capture indicator -->
    <div id="capture-indicator">📸 Imagem capturada</div>

    <!-- Setup banner -->
    <div id="setup-banner">
      <div class="title">⚠️ Configure sua ANTHROPIC_API_KEY</div>
      <div class="desc">
        Adicione <code>ANTHROPIC_API_KEY</code> nas variáveis de ambiente do
        Cloudflare Workers para ativar a IA. Enquanto isso, respostas demo estão ativas.
      </div>
    </div>

    <!-- Toast -->
    <div id="toast"></div>

    <!-- Main UI -->
    <div class="ui">
      <!-- Top bar -->
      <div class="top-bar">
        <a href="/" class="back-btn">← Dashboard</a>

        <div class="logo-pill">
          <span class="dot"></span>
          <span class="name">FabioAI</span>
          <span class="version">v2 · Voz+Câmera</span>
        </div>

        <div class="top-actions">
          <button class="top-btn" id="btn-cam" title="Câmera on/off">📷</button>
          <button class="top-btn" id="btn-capture" title="Capturar frame para a IA ver">📸</button>
          <button class="top-btn" id="btn-clear" title="Nova conversa">🗑️</button>
        </div>
      </div>

      <!-- Center -->
      <div class="center">
        <div class="orb-wrap">
          <div class="orb" id="orb">
            <div class="orb-r2"></div>
            <div class="orb-r1"></div>
            <div class="orb-core"></div>
          </div>
          <div class="orb-status" id="orb-status">FabioAI pronto ✦</div>
        </div>

        <div class="msgs" id="msgs"></div>
      </div>

      <!-- Bottom bar -->
      <div class="bottom">
        <div class="transcript-pill" id="transcript">
          Pressione o microfone para falar
        </div>

        <div class="mic-row">
          <button class="side-btn" id="btn-stop" title="Parar fala da IA">⏹</button>
          <button class="mic-btn" id="btn-mic">🎤</button>
          <button class="side-btn" id="btn-repeat" title="Repetir última resposta">🔁</button>
        </div>

        <div class="mic-hint" id="mic-hint">Clique para falar</div>

        <div class="text-row">
          <input
            type="text"
            class="txt-inp"
            id="txt-inp"
            placeholder="Ou escreva aqui e pressione Enter…"
          />
          <button class="send-btn" id="btn-send">➤</button>
        </div>
      </div>
    </div>

    <script>
      // ── Types / State ────────────────────────────────────
      let camStream = null;
      let camOn = false;
      let isListening = false;
      let isThinking = false;
      let isSpeaking = false;
      let recognition = null;
      let pendingCapture = null;
      let lastAIText = "";
      const history = [];

      const camBg    = document.getElementById("cam-bg");
      const camPip   = document.getElementById("cam-pip");
      const camPipVid = document.getElementById("cam-pip-vid");
      const noCamBg  = document.getElementById("no-cam-bg");
      const orb      = document.getElementById("orb");
      const orbStatus = document.getElementById("orb-status");
      const msgsEl   = document.getElementById("msgs");
      const transcript = document.getElementById("transcript");
      const btnMic   = document.getElementById("btn-mic");
      const btnCam   = document.getElementById("btn-cam");
      const btnCapture = document.getElementById("btn-capture");
      const btnClear = document.getElementById("btn-clear");
      const btnStop  = document.getElementById("btn-stop");
      const btnRepeat = document.getElementById("btn-repeat");
      const txtInp   = document.getElementById("txt-inp");
      const btnSend  = document.getElementById("btn-send");
      const toastEl  = document.getElementById("toast");
      const capIndicator = document.getElementById("capture-indicator");
      const setupBanner = document.getElementById("setup-banner");

      // ── Orb state ────────────────────────────────────────
      function setOrb(state, label) {
        orb.className = "orb " + (state !== "idle" ? state : "");
        const labels = {
          idle:      "FabioAI pronto ✦",
          listening: "🎙 Ouvindo você…",
          thinking:  "💭 Processando…",
          speaking:  "🔊 Falando…",
        };
        orbStatus.textContent = label || labels[state] || labels.idle;
      }

      // ── Toast ────────────────────────────────────────────
      let toastTimer = null;
      function showToast(msg, ms = 3500) {
        toastEl.textContent = msg;
        toastEl.style.display = "block";
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { toastEl.style.display = "none"; }, ms);
      }

      // ── Messages ─────────────────────────────────────────
      function addMsg(role, text) {
        const div = document.createElement("div");
        div.className = "msg " + role;
        div.innerHTML =
          '<div class="msg-av">' + (role === "ai" ? "🤖" : "👤") + "</div>" +
          '<div class="msg-bub">' + text.replace(/\n/g, "<br>") + "</div>";
        msgsEl.appendChild(div);
        msgsEl.scrollTop = msgsEl.scrollHeight;
      }

      // ── Camera ───────────────────────────────────────────
      async function startCam() {
        try {
          camStream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: "user", width: { ideal: 1280 }, height: { ideal: 720 } },
            audio: false,
          });
          camBg.srcObject = camStream;
          camPipVid.srcObject = camStream;
          camBg.style.display = "block";
          camPip.style.display = "block";
          noCamBg.style.display = "none";
          camOn = true;
          btnCam.classList.remove("cam-off");
          btnCam.textContent = "📷";
          showToast("📷 Câmera ativa — a IA pode ver você!");
        } catch {
          camOn = false;
          showToast("Câmera não disponível. Usando modo só de voz.");
        }
      }

      function stopCam() {
        if (camStream) camStream.getTracks().forEach((t) => t.stop());
        camStream = null;
        camBg.srcObject = null;
        camPipVid.srcObject = null;
        camBg.style.display = "none";
        camPip.style.display = "none";
        noCamBg.style.display = "block";
        camOn = false;
        btnCam.classList.add("cam-off");
        btnCam.textContent = "🚫";
        showToast("Câmera desligada.");
      }

      function captureFrame() {
        if (!camStream || !camBg.videoWidth) return null;
        const c = document.createElement("canvas");
        c.width = 640; c.height = 480;
        const ctx = c.getContext("2d");
        ctx.translate(c.width, 0);
        ctx.scale(-1, 1);
        ctx.drawImage(camBg, 0, 0, c.width, c.height);
        return c.toDataURL("image/jpeg", 0.8).split(",")[1];
      }

      // ── TTS ──────────────────────────────────────────────
      function speak(text) {
        return new Promise((resolve) => {
          window.speechSynthesis.cancel();
          const utt = new SpeechSynthesisUtterance(text);
          utt.lang = "pt-BR";
          utt.rate = 1.05;
          utt.pitch = 1.0;
          utt.volume = 1.0;

          const voices = window.speechSynthesis.getVoices();
          const ptVoice =
            voices.find((v) => v.lang === "pt-BR") ||
            voices.find((v) => v.lang.startsWith("pt")) ||
            voices[0];
          if (ptVoice) utt.voice = ptVoice;

          setOrb("speaking");
          isSpeaking = true;

          utt.onend = () => {
            isSpeaking = false;
            setOrb("idle");
            resolve();
          };
          utt.onerror = () => {
            isSpeaking = false;
            setOrb("idle");
            resolve();
          };

          window.speechSynthesis.speak(utt);
        });
      }

      // ── Demo fallback responses ───────────────────────────
      const DEMO = [
        "Olá Fabio! Estou funcionando no modo demo. Configure sua ANTHROPIC_API_KEY para respostas reais de IA.",
        "Entendido! Em produção eu processo tudo com Claude — configure a chave da API Anthropic no Cloudflare.",
        "Fabio, para ativar a IA completa, adicione ANTHROPIC_API_KEY nas variáveis do Workers. Por enquanto estou em modo demo!",
        "Mensagem recebida! Quando a API key estiver configurada, vou poder te responder com inteligência real.",
      ];
      let demoIdx = 0;

      // ── Chat API ─────────────────────────────────────────
      async function sendToAI(message, imageB64) {
        setOrb("thinking");
        isThinking = true;

        const histSlice = history.slice(-14);

        try {
          const res = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message, image: imageB64 || null, history: histSlice }),
          });

          const data = await res.json();

          if (!res.ok || data.error) {
            // Show setup banner if key missing
            if (res.status === 503) {
              setupBanner.style.display = "block";
              setTimeout(() => { setupBanner.style.display = "none"; }, 8000);
            }
            // Fall back to demo response
            const demo = DEMO[demoIdx % DEMO.length];
            demoIdx++;
            history.push({ role: "user", content: message });
            history.push({ role: "assistant", content: demo });
            addMsg("ai", demo);
            isThinking = false;
            await speak(demo);
            return;
          }

          const reply = data.response || "Não consegui processar.";
          lastAIText = reply;

          // Build proper user content for history
          const userContent = imageB64
            ? [
                { type: "image", source: { type: "base64", media_type: "image/jpeg", data: imageB64 } },
                { type: "text", text: message },
              ]
            : message;

          history.push({ role: "user", content: userContent });
          history.push({ role: "assistant", content: reply });

          addMsg("ai", reply);
          isThinking = false;
          await speak(reply);

        } catch {
          showToast("Erro de conexão com a IA.");
          setOrb("idle");
          isThinking = false;
        }
      }

      // ── Speech recognition ────────────────────────────────
      function initSR() {
        const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SR) {
          showToast("Reconhecimento de voz indisponível. Use Chrome ou Edge.", 5000);
          btnMic.style.opacity = "0.4";
          btnMic.title = "Voz não suportada neste navegador";
          return;
        }

        recognition = new SR();
        recognition.lang = "pt-BR";
        recognition.continuous = false;
        recognition.interimResults = true;
        recognition.maxAlternatives = 1;

        recognition.onstart = () => {
          isListening = true;
          btnMic.classList.add("recording");
          btnMic.textContent = "🔴";
          document.getElementById("mic-hint").textContent = "Clique para parar";
          setOrb("listening");
          transcript.textContent = "🎙 Te ouvindo…";
          transcript.classList.add("active");
        };

        recognition.onresult = (e) => {
          let interim = "", final = "";
          for (let i = e.resultIndex; i < e.results.length; i++) {
            if (e.results[i].isFinal) final += e.results[i][0].transcript;
            else interim += e.results[i][0].transcript;
          }
          transcript.textContent = final || interim || "🎙 Te ouvindo…";
          if (final) recognition.stop();
        };

        recognition.onend = () => {
          const text = transcript.textContent;
          isListening = false;
          btnMic.classList.remove("recording");
          btnMic.textContent = "🎤";
          document.getElementById("mic-hint").textContent = "Clique para falar";
          transcript.classList.remove("active");

          if (text && text !== "🎙 Te ouvindo…" && text !== "Pressione o microfone para falar") {
            const cap = pendingCapture;
            pendingCapture = null;
            capIndicator.style.display = "none";
            addMsg("user", text + (cap ? " 📸" : ""));
            transcript.textContent = "Pressione o microfone para falar";
            sendToAI(text, cap);
          } else {
            setOrb("idle");
            transcript.textContent = "Pressione o microfone para falar";
          }
        };

        recognition.onerror = (e) => {
          if (e.error !== "aborted" && e.error !== "no-speech") {
            showToast("Erro no microfone: " + e.error);
          }
          isListening = false;
          btnMic.classList.remove("recording");
          btnMic.textContent = "🎤";
          transcript.classList.remove("active");
          transcript.textContent = "Pressione o microfone para falar";
          setOrb("idle");
        };
      }

      // ── Button listeners ──────────────────────────────────
      btnMic.addEventListener("click", () => {
        if (isSpeaking) {
          window.speechSynthesis.cancel();
          isSpeaking = false;
          setOrb("idle");
          return;
        }
        if (!recognition) return;
        if (isListening) {
          recognition.stop();
        } else if (!isThinking) {
          recognition.start();
        }
      });

      btnCam.addEventListener("click", () => {
        if (camOn) stopCam();
        else startCam();
      });

      btnCapture.addEventListener("click", () => {
        const frame = captureFrame();
        if (frame) {
          pendingCapture = frame;
          capIndicator.style.display = "block";
          showToast("📸 Frame capturado! A IA vai ver na próxima mensagem.");
          btnCapture.textContent = "✅";
          setTimeout(() => { btnCapture.textContent = "📸"; }, 2500);
        } else {
          showToast("Ligue a câmera primeiro (📷) para capturar.");
        }
      });

      btnClear.addEventListener("click", () => {
        history.length = 0;
        msgsEl.innerHTML = "";
        window.speechSynthesis.cancel();
        pendingCapture = null;
        capIndicator.style.display = "none";
        setOrb("idle");
        transcript.textContent = "Pressione o microfone para falar";
        showToast("🗑️ Conversa reiniciada.");
      });

      btnStop.addEventListener("click", () => {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        setOrb("idle");
      });

      btnRepeat.addEventListener("click", () => {
        if (lastAIText) speak(lastAIText);
        else showToast("Nenhuma fala para repetir.");
      });

      async function handleSend() {
        const text = txtInp.value.trim();
        if (!text || isThinking) return;
        txtInp.value = "";
        const cap = pendingCapture;
        pendingCapture = null;
        capIndicator.style.display = "none";
        addMsg("user", text + (cap ? " 📸" : ""));
        await sendToAI(text, cap);
      }

      btnSend.addEventListener("click", handleSend);
      txtInp.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          handleSend();
        }
      });

      // Pre-load voices
      window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
      window.speechSynthesis.getVoices();

      // ── Init ─────────────────────────────────────────────
      async function init() {
        initSR();
        await startCam();

        setTimeout(async () => {
          const greet =
            "Olá Fabio! Estou aqui, pode falar comigo. Posso ver você pela câmera e te ouvir pelo microfone.";
          addMsg("ai", greet);
          lastAIText = greet;
          history.push({ role: "assistant", content: greet });
          await speak(greet);
        }, 600);
      }

      init();
    </script>
  </body>
</html>
